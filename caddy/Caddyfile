{$DOMAIN} {
	# API and its webhook first — more specific path wins regardless of
	# declaration order, but keeping it first mirrors the routing intent.
	handle /api/* {
		reverse_proxy http_server:4000
	}

	handle /health {
		reverse_proxy http_server:4000
	}

	# Everything else is the Next.js app.
	handle {
		reverse_proxy web:3000
	}

	encode gzip
}
