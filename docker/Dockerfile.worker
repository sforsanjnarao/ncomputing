FROM node:20-alpine

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy the entire repository
COPY . .

# Remove local .env files so we use Docker environment variables
RUN rm -f .env apps/*/.env packages/*/.env

# Install dependencies
RUN pnpm install

# Build the worker and everything it depends on (@repo/db, @repo/types)
RUN pnpm exec turbo run build --filter=worker...

WORKDIR /app/apps/worker

CMD ["node", "dist/src/index.js"]
