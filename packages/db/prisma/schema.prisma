// NComputing India store — data model.
//
// Money is stored everywhere as an integer number of paise (1 rupee = 100 paise).
// Floats are never used for currency: 0.1 + 0.2 !== 0.3 is not something you want
// anywhere near an invoice total.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ProductType {
  HARDWARE
  SOFTWARE
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum LeadType {
  DEMO
  SALES
  PRICING
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String // bcrypt hash, never the plaintext
  phone        String?
  organization String?
  addresses Address[]
  role         Role     @default(USER)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  
  // usersPerDevice Int
  type ProductType 
  price    Int
  // imageEmoji     String          @default("🖥️")
  isActive       Boolean         @default(true) //can we show in the website or not
  // sortOrder      Int             @default(0)
  // Free-form marketing/spec content that only ever gets rendered, never queried.
  marketing ProductMarketing?
  // options        ProductOption[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ProductMarketing {
  id             String  @id @default(cuid())

  // @unique makes this a one-to-one relationship.
  productId      String  @unique
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  tagline        String
  summary        String
  highlights     String[]
  specifications Json

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A configurable add-on for a product (support plan, licence pack, dongle kit).
// Options are grouped; the UI renders one radio group per `group`.
