// NComputing India store — data model.
//
// Money is stored everywhere as an integer number of paise (1 rupee = 100 paise).
// Floats are never used for currency, and Razorpay's own `amount` field is paise
// too — naming it *InPaise* everywhere is what stops that unit from getting
// mixed up with rupees at a call site.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ProductType {
  HARDWARE
  SOFTWARE
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum LeadType {
  DEMO
  SALES
  PRICING
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

// enum Currency {

// }
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String // bcrypt hash, never the plaintext
  phone        String?
  organization String?
  role         Role     @default(USER)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id       String      @id @default(cuid())
  slug     String      @unique
  name     String
  type     ProductType
  // priceInPaise Int  //use rupess
  amount Float
  currency String @default("INR")
  isActive Boolean     @default(true) // show on the site or not

  // Marketing copy — folded onto the product instead of a separate table.
  // It only ever gets rendered, never queried on its own.
  tagline        String
  summary        String
  highlights     String[]
  specifications Json

  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  // Every order belongs to a logged-in user. Ownership checks in the
  // controller compare this against the JWT subject.
  userId String
  user   User   @relation(fields: [userId], references: [id])

  orderAmount Float
  orderCurrency String @default("INR")

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String?

  items OrderItem[]
  //address imp

  // Snapshot of where the order goes, taken at checkout — a JSON blob rather
  // than a row in its own table, so a user editing a saved address later can
  // never rewrite the history of where a past order was actually sent.
  billingAddress  Json // required for every order
  shippingAddress Json? // only present when the cart contains hardware

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

//hardware
  quantity Int @default(1)

  // Only set for SOFTWARE line items.
  licenceSeats          Int?
  serviceDurationMonths Int?
  serviceStartsAt       DateTime?
  serviceEndsAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

// A visitor who is not ready to buy yet — captured from the "Request a demo" /
// "Contact sales" / "Request pricing" forms on the marketing site.
model Lead {
  id           String     @id @default(cuid())
  type         LeadType
  name         String
  email        String
  phone        String
  organization String?
  seats        Int?
  productSlug  String?
  message      String?
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}
