// NComputing India store — data model.
//
// Money is stored everywhere as an integer number of paise (1 rupee = 100 paise).
// Floats are never used for currency, and Razorpay's own `amount` field is paise
// too — naming it *InPaise* everywhere is what stops that unit from getting
// mixed up with rupees at a call site.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ProductType {
  HARDWARE
  SOFTWARE
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum LeadType {
  DEMO
  SALES
  PRICING
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum VisitorEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_STARTED
  LEAD_SUBMITTED
}


model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String // bcrypt hash, never the plaintext
  phone        String?
  organization String?
  addresses Address[]
  role         Role     @default(USER)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id       String      @id @default(cuid())
  slug     String      @unique
  name     String
  type     ProductType
  // priceInPaise Int  //use rupess
  amount Float
  currency String @default("INR")
  isActive Boolean     @default(true) // show on the site or not

  tagline        String
  summary        String
  highlights     String[]
  specifications Json

  // Structured (not buried in `specifications`) because the comparison table
  // needs to read the same field name for every product, not guess a JSON key.
  platforms String[]

  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Address {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName  String
  fullAddress String
  city      String
  state     String
  postalCode String
  country   String   @default("India")

  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  
  userId String
  user   User   @relation(fields: [userId], references: [id])

  orderAmount Float
  orderCurrency String @default("INR")

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String?

  items OrderItem[]
  //address imp

   // Mandatory for every order.
  billingAddressId String
  billingAddress   Address @relation("BillingAddress",fields: [billingAddressId],references: [id])

  // Required only when the cart contains physical hardware.
  shippingAddressId String?
  shippingAddress   Address? @relation("ShippingAddress",fields: [shippingAddressId],references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

//hardware
  quantity Int @default(1)

//SOFTWARE
  seats                 Int?
  serviceDurationMonths Int?
  serviceStartsAt       DateTime?
  serviceEndsAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}


model Lead {
  id           String     @id @default(cuid())
  type         LeadType
  name         String
  email        String
  phone        String
  organization String?
  seats        Int?
  productSlug  String?
  message      String?
  status       LeadStatus @default(NEW)

  
  visitorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([visitorId])
}


model VisitorEvent {
  id          String           @id @default(cuid())
  visitorId   String
  type        VisitorEventType
  path        String?
  productSlug String?
  createdAt   DateTime         @default(now())

  @@index([visitorId])
  @@index([createdAt])
}
