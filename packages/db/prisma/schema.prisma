model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  // Every order belongs to a logged-in user. Ownership checks in the service
  // layer compare this against the JWT subject.
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Snapshot of the customer at the time of purchase. Denormalised on purpose:
  // if the user later edits their profile, the order must not silently change.
  // customerName  String
  // customerEmail String
  // customerPhone String

  // shippingAddress Json //make a schema of address
  // billingAddress  Json

  // subtotalInPaise Int
  // taxInPaise      Int
  // totalInPaise    Int
  amount Int //in rupess as rasorpay except in rupees

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String?

  items     OrderItem[]

   // Mandatory for every order.
  billingAddressId String
  billingAddress   Address @relation("BillingAddress",fields: [billingAddressId],references: [id])

  // Required only when the cart contains physical hardware.
  shippingAddressId String?
  shippingAddress   Address? @relation("ShippingAddress",fields: [shippingAddressId],references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Name and price are snapshotted so an admin editing the catalogue later
  // cannot rewrite the history of what somebody actually paid.
  // productName       String
  // unitPriceInPaise  Int  already getting from the product realasion
  quantity          Int

  // Used only for software such as vSpace.
  licenceSeats          Int?
  serviceDurationMonths Int?
  serviceStartsAt DateTime?
  serviceEndsAt   DateTime?
  // selectedOptions   Json 
  // lineTotalInPaise  Int can calculate it 

  @@index([orderId])
}

model Address {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName  String
  phone       String
  fullAddress String
  city      String
  state     String
  postalCode String
  country   String   @default("India")

  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}


model Lead {
  id           String     @id @default(cuid())
  type         LeadType
  name         String
  email        String
  phone        String
  organization String?
  seats        Int?
  productSlug  String?
  message      String?
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}
