// NComputing India store — data model.
//
// Money is stored everywhere as an integer number of paise (1 rupee = 100 paise).
// Floats are never used for currency: 0.1 + 0.2 !== 0.3 is not something you want
// anywhere near an invoice total.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ProductType {
  HARDWARE
  SOFTWARE
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum LeadType {
  DEMO
  SALES
  PRICING
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  password     String // bcrypt hash, never the plaintext
  phone        String?
  organization String?
  role         Role     @default(USER)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  tagline        String
  summary        String
  usersPerDevice Int
  priceInPaise   Int
  imageEmoji     String          @default("🖥️")
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  // Free-form marketing/spec content that only ever gets rendered, never queried.
  highlights     String[]
  specs          Json
  options        ProductOption[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// A configurable add-on for a product (support plan, licence pack, dongle kit).
// Options are grouped; the UI renders one radio group per `group`.
model ProductOption {
  id                String  @id @default(cuid())
  productId         String
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  group             String
  label             String
  description       String?
  priceDeltaInPaise Int     @default(0)
  isDefault         Boolean @default(false)
  sortOrder         Int     @default(0)

  @@index([productId])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  // Every order belongs to a logged-in user. Ownership checks in the service
  // layer compare this against the JWT subject.
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Snapshot of the customer at the time of purchase. Denormalised on purpose:
  // if the user later edits their profile, the order must not silently change.
  // customerName  String
  // customerEmail String
  // customerPhone String

  shippingAddress Json //make a schema of address
  // billingAddress  Json

  // subtotalInPaise Int
  // taxInPaise      Int
  // totalInPaise    Int
  amount Int //in rupess as rasorpay except in rupees

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Name and price are snapshotted so an admin editing the catalogue later
  // cannot rewrite the history of what somebody actually paid.
  // productName       String
  unitPriceInPaise  Int
  quantity          Int

  serviceDurationMonths Int
  serviceStartsAt DateTime?
  serviceEndsAt   DateTime?
  // selectedOptions   Json 
  // lineTotalInPaise  Int can calculate it 

  @@index([orderId])
}

model Lead {
  id           String     @id @default(cuid())
  type         LeadType
  name         String
  email        String
  phone        String
  organization String?
  seats        Int?
  productSlug  String?
  message      String?
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}
