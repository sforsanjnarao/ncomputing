# Variables for `docker-compose.prod.yml` — copy to `.env` next to the compose
# file (docker compose reads it automatically) and fill in real values.
# Per-service .env.example files (apps/http_server, apps/worker, apps/web,
# packages/db) are for local `pnpm dev` only and are not used by this stack.

# --- Domain -------------------------------------------------------------
# Public hostname, no protocol. Both the web app and the API are served from
# here (see caddy/Caddyfile) — the browser calls /api/* on this same origin.
DOMAIN="example.com"

# --- Postgres -------------------------------------------------------------
POSTGRES_USER="ncomputing"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="ncomputing"

# --- Auth -------------------------------------------------------------------
# Any random string of 16+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# --- Payments (Razorpay live keys) ------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
# Requires a verified sending domain (resend.com/domains) — the shared
# onboarding@resend.dev sender only delivers to your own Resend account email.
MAIL_FROM="NComputing India <orders@example.com>"
# Internal inbox alerted on every new lead. Leave empty to skip that alert.
LEAD_NOTIFY_TO=""
