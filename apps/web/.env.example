# Base URL of the Express API as seen by the browser. Baked into the client
# bundle, so it must be reachable from the user's machine.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Base URL of the Express API as seen by the Next.js server (React Server
# Components fetching the public catalogue). In Docker this is the internal
# service name, e.g. http://http_server:4000.
API_URL="http://localhost:4000"
